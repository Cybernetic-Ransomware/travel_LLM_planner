# Production-shaped environment for travel-planner. Copy to .env and fill in real values.
# Local development / the Docker stack use docker/.env.template instead.

DEBUG=False
LOG_DIR=log

MONGO_URI=mongodb://localhost:27017
MONGO_DB=travel_planner

# Turso / libSQL — persisted trips + revision history (ADR-21).
# Production: a libsql:// URL plus an auth token (the libsql driver, Linux).
# Local dev / CI: a file: URL (stdlib sqlite3 backend), e.g. file:./data/trips.db
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN=""
# Require the Turso migration-complete marker at startup. Keep True in production:
# run `just migrate-trips-to-turso` before first boot (it verifies the source and stamps
# the marker; a fresh empty source is stamped too). Set False only for local hacking.
TRIPS_REQUIRE_MIGRATION_MARKER=True

GOOGLE_PLACES_API_KEY=""
GOOGLE_ROUTES_API_KEY=""

LLM_PROVIDER="openai"
LLM_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

LANGSMITH_TRACING=False
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="travel-planner"

CHECKPOINT_TTL_DAYS=30

CORS_ALLOW_ORIGINS="http://localhost:4321,http://127.0.0.1:4321"

AUTH_ENABLED=False
AUTH0_DOMAIN=""
AUTH0_AUDIENCE=""
