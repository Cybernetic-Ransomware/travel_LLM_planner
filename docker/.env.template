DEBUG=False
LOG_DIR=/log

MONGO_URI=mongodb://mongo:27017
MONGO_DB=travel_planner

# Turso / libSQL — persisted trips + revision history (ADR-21). A file: URL uses the stdlib
# sqlite3 backend; a libsql:// URL uses the libsql driver + TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=file:/data/trips.db
TURSO_AUTH_TOKEN=""
# Require the Turso migration-complete marker at startup. Keep True in production (run
# `just migrate-trips-to-turso` first — it also stamps the marker for a fresh empty source).
# False here so `just docker-up` boots without a migration step for local development.
TRIPS_REQUIRE_MIGRATION_MARKER=False

SCRAPER_DEBUG=1
GOOGLE_PLACES_API_KEY=""
GOOGLE_ROUTES_API_KEY=""

# LLM provider: "openai" or "anthropic"
LLM_PROVIDER="openai"
LLM_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# LangSmith tracing (optional)
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="travel-planner"

# Checkpoint retention (days before orchestrator_checkpoints documents expire)
CHECKPOINT_TTL_DAYS=30

# Browser origins allowed to call the API directly (dev frontends), comma-separated.
CORS_ALLOW_ORIGINS="http://localhost:4321,http://127.0.0.1:4321"

# Auth0 RS256 authentication — set AUTH_ENABLED=True and fill domain/audience for production.
# Leave AUTH_ENABLED=False to disable token verification (local dev / CI).
AUTH_ENABLED=False
AUTH0_DOMAIN=""
AUTH0_AUDIENCE=""
