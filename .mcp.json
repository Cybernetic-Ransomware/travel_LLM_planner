{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--browser", "msedge", "--ignore-https-errors"]
    },
    "travel-planner": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", ".claude/plugins/server.py"]
    },
    "svelte": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@sveltejs/mcp"],
      "cwd": "apps/frontend"
    }
  }
}